# a task without acceptance criteria goes through the slice and ends with a diff-only report
env GIT_CONFIG_NOSYSTEM=1
env GIT_AUTHOR_NAME=dev GIT_AUTHOR_EMAIL=dev@example.com GIT_COMMITTER_NAME=dev GIT_COMMITTER_EMAIL=dev@example.com
mkdir repo
cd repo
exec git init -q -b main
cp ../a.txt a.txt
exec git add -A
exec git commit -q -m init
exec git checkout -q -b feature

exec plait run new order-retry
stdin ../task.md
exec plait ctx save --json
exec plait next --json
capture INPUT '"inputs":\["([^"]+)"\]'
grep 'plait:gap acceptance_criteria' $INPUT

cp ../a2.txt a.txt
exec plait review export --json
stdout '"coverage":"diff_only"'
capture SNAPSHOT '"commit":"([0-9a-f]{40})"'
expand ../answer.json ../answer-ok.json
exec plait review import ../answer-ok.json --json
exec plait review report --json
stdout '"coverage":"diff_only","coverage_label":"only the diff was checked: the task has no acceptance criteria"'
stdout '"coverage_gaps":\[\].*"counts":\{"new":0,"open":0,"region_changed":0,"outdated":0,"fix_confirmed":0\},"blocking":0,"findings":\[\]'
exec plait next --json
stdout '"step":"reported".*"output":\{"cmd":"plait mr describe"\}'

-- a.txt --
a
-- a2.txt --
a changed
-- task.md --
# Retry failed orders

Retry orders that failed.
-- answer.json --
{"snapshot": "$SNAPSHOT", "coverage": "diff_only", "findings": []}
