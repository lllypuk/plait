env GIT_CONFIG_NOSYSTEM=1
env GIT_AUTHOR_NAME=dev GIT_AUTHOR_EMAIL=dev@example.com GIT_COMMITTER_NAME=dev GIT_COMMITTER_EMAIL=dev@example.com
mkdir repo
cd repo
exec git init -q -b main
cp ../a.txt a.txt
cp ../AGENTS.md AGENTS.md
exec git add -A
exec git commit -q -m init
exec git checkout -q -b feature
exec plait run new order-retry

# export needs a saved task
exitcode 2 plait review export --json
stdout '"code":"no_task"'
stdout '"fix":"save the task'

stdin ../task.md
exec plait ctx save --json

# a base that does not exist is invalid with a fix
exitcode 2 plait review export --base nope --json
stdout '"code":"base_not_found"'

# nothing changed against the base
exitcode 2 plait review export --json
stdout '"code":"empty_diff"'

cp ../a2.txt a.txt
exec git add a.txt
exec git diff --cached --name-only
cp stdout ../cached-before

exec plait review export --json
stdout '"snapshot":1,.*"coverage":"criteria","package":"\.plait/runs/[0-9-]+-order-retry/review-1/package.md","changed":true,"step":"exported"'
exec git diff --cached --name-only
cmp stdout ../cached-before
exec plait next --json
stdout '"inputs":\["\.plait/runs/[0-9-]+-order-retry/review-1/package.md"\]'
exec plait review export --json
stdout '"snapshot":1,.*"changed":false'

# a change after export gives snapshot 2
cp ../a.txt a.txt
cp ../new.txt new.txt
exec plait review export --json
stdout '"snapshot":2,.*"changed":true'

-- a.txt --
a
-- a2.txt --
a changed
-- new.txt --
new
-- AGENTS.md --
Run make check.
-- task.md --
# Retry failed orders

## Acceptance criteria

- retried 3 times
