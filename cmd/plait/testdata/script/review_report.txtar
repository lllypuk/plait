env GIT_CONFIG_NOSYSTEM=1
env GIT_AUTHOR_NAME=dev GIT_AUTHOR_EMAIL=dev@example.com GIT_COMMITTER_NAME=dev GIT_COMMITTER_EMAIL=dev@example.com
mkdir repo
cd repo
exec git init -q -b main
cp ../a.txt a.txt
exec git add -A
exec git commit -q -m init
exec git checkout -q -b feature
exec plait run new order-retry
stdin ../task.md
exec plait ctx save --json
cp ../a2.txt a.txt
exec plait review export --json
capture SNAPSHOT '"commit":"([0-9a-f]{40})"'
expand ../answer.json ../answer-ok.json

# nothing to report before the answer is imported
exitcode 2 plait review report --json
stdout '"code":"no_review".*"fix":"review the exported package.md in a fresh session, then plait review import <file>"'

exec plait review import ../answer-ok.json --json
exec plait review report --json
stdout '"coverage":"diff_only","coverage_label":"only the diff was checked: the task has no acceptance criteria","stale":false'
stdout '"counts":\{"blocker":1,"major":0,"minor":0,"nit":1\},"findings":\[\{"id":"F2".*\{"id":"F1".*"step":"reported"'
exec plait next --json
stdout '"step":"reported"'

# a repeat report changes nothing; a change after the snapshot marks it stale
exec plait review report --json
stdout '"stale":false.*"step":"reported"'
cp ../a.txt a.txt
exec plait review report --json
stdout '"stale":true'

-- a.txt --
a
-- a2.txt --
a changed
-- task.md --
# Retry failed orders

Retry orders that failed.
-- answer.json --
{
  "snapshot": "$SNAPSHOT",
  "coverage": "diff_only",
  "findings": [
    {"id": "F1", "severity": "nit", "file": "a.txt", "line": 1, "title": "wording", "rationale": "unclear"},
    {"id": "F2", "severity": "blocker", "file": "a.txt", "line": 1, "title": "no retry", "rationale": "the order is not retried"}
  ]
}
