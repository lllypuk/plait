{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lllypuk/plait/schemas/plait-agent.v1.json",
  "title": "plait-agent/v1",
  "description": "A coding agent after base inheritance is resolved.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "cmd", "skill_dirs", "context_file"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "base": {"description": "Agent whose fields this one takes and overrides.", "type": "string", "minLength": 1},
    "display": {"type": "string"},
    "cmd": {"description": "Executable looked up in PATH.", "type": "string", "minLength": 1},
    "version_args": {"type": "array", "items": {"type": "string"}},
    "skill_dirs": {"$ref": "#/$defs/scopes"},
    "context_file": {"description": "Context file the agent reads at the repository root.", "type": "string", "minLength": 1},
    "skill_frontmatter": {"description": "Keys added to the frontmatter of stage skills.", "type": "object"},
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["writer"],
      "properties": {
        "writer": {"description": "Settings format that denies commands to the agent; none when the agent has no such setting.", "type": "string", "minLength": 1},
        "user": {"type": "string", "minLength": 1},
        "project": {"type": "string", "minLength": 1},
        "deny": {"description": "Shell commands the agent must not run itself.", "type": "array", "items": {"type": "string", "minLength": 1}},
        "source": {"description": "Documentation the format was taken from.", "type": "string"}
      },
      "if": {"properties": {"writer": {"not": {"const": "none"}}}},
      "then": {"required": ["user", "project", "deny"], "properties": {"deny": {"minItems": 1}}}
    },
    "telemetry_off": {
      "description": "Telemetry counts as off when any condition holds.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "maxProperties": 1,
        "properties": {
          "env": {"description": "Variable set to a value other than empty, 0 or false.", "type": "string", "minLength": 1},
          "json": {
            "description": "Value at a dotted path of a JSON file; without equals any value other than empty, 0 or false.",
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "path"],
            "properties": {
              "file": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "equals": {}
            }
          }
        }
      }
    },
    "model_endpoint_env": {"description": "Variable holding the model endpoint URL.", "type": "string"}
  },
  "$defs": {
    "scopes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "project"],
      "properties": {
        "user": {"description": "Path under the home directory, written with ~/.", "type": "string", "minLength": 1},
        "project": {"description": "Path from the repository root.", "type": "string", "minLength": 1}
      }
    }
  }
}
